{
  "name": "opportunity-cost-firefox-source",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:firefox",
    "build:firefox": "tsc -b && vite build --mode firefox && vite build --mode firefox --config vite.content.config.ts && vite build --mode firefox --config vite.background.config.ts",
    "package:firefox": "npm run build:firefox && cd dist/firefox && zip -r ../oc-firefox.zip .",
    "package": "npm run package:firefox",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:ts": "tsc -b --watch",
    "dev:firefox": "cross-env WATCH=1 concurrently \"npm run dev:ts\" \"vite build --mode firefox --watch\" \"vite build --mode firefox --config vite.content.config.ts --watch\" \"vite build --mode firefox --config vite.background.config.ts --watch\"",
    "dev": "npm run dev:firefox"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cleave.js": "^1.6.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "numeral": "^2.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/cleave.js": "^1.4.12",
    "@types/node": "^26.1.2",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "webextension-polyfill": "^0.12.0"
  }
}
